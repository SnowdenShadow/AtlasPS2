/*
 * AtlasPS2 - atlascdvd exports.tab
 *
 * The export table of the module that replaces cdvdman.
 *
 * READ THIS BEFORE CHANGING A LINE OF IT
 * --------------------------------------
 * A game does not link to `sceCdRead`. It links to entry 6 of whatever
 * library is registered under the name "cdvdman". The name in each
 * DECLARE_EXPORT below is for a human; the *position* is the contract.
 *
 * So the table is dense and gapless from 0 to the last entry, and every
 * position that the real cdvdman fills but this module does not must
 * still be occupied - by a stub that fails politely. A missing line
 * does not leave a hole: it shifts everything after it up by one, and
 * a game that called sceCdSync() reaches sceCdGetDiskType() instead.
 * That links cleanly, runs, and returns nonsense.
 *
 * Entries 0-3 are the module's own hooks, in the order loadcore
 * expects: start, stop, restart, exit/keep-alive. Everything from 4 on
 * matches the ordinals in $PS2SDK/iop/include/cdvdman.h, which is the
 * only authority here - not this comment, and not memory.
 *
 * The real cdvdman's table runs past 190 on late consoles. This one
 * stops at 84 (sceCdLayerSearchFile) because that is the last ordinal
 * before the table becomes sparse, and a game linking to something
 * beyond it gets a link failure - which is loud - rather than a wrong
 * function, which is not.
 */

DECLARE_EXPORT_TABLE(cdvdman, 1, 1)

/* 0-3: loadcore's own hooks. */
DECLARE_EXPORT(_start)
DECLARE_EXPORT(_retonly)        /* 1: shutdown  */
DECLARE_EXPORT(_retonly)        /* 2: restart   */
DECLARE_EXPORT(_retonly)        /* 3: unused    */

/* 4 */  DECLARE_EXPORT(sceCdInit)
/* 5 */  DECLARE_EXPORT(sceCdStandby)
/* 6 */  DECLARE_EXPORT(sceCdRead)
/* 7 */  DECLARE_EXPORT(sceCdSeek)
/* 8 */  DECLARE_EXPORT(sceCdGetError)
/* 9 */  DECLARE_EXPORT(sceCdGetToc)
/* 10 */ DECLARE_EXPORT(sceCdSearchFile)
/* 11 */ DECLARE_EXPORT(sceCdSync)
/* 12 */ DECLARE_EXPORT(sceCdGetDiskType)
/* 13 */ DECLARE_EXPORT(sceCdDiskReady)
/* 14 */ DECLARE_EXPORT(sceCdTrayReq)
/* 15 */ DECLARE_EXPORT(sceCdStop)
/* 16 */ DECLARE_EXPORT(sceCdPosToInt)
/* 17 */ DECLARE_EXPORT(sceCdIntToPos)
/* 18 */ DECLARE_EXPORT(atlas_cdvd_null)      /* unused in the real one */
/* 19 */ DECLARE_EXPORT(sceCdGetToc2)
/* 20 */ DECLARE_EXPORT(sceCdReadDVDV)
/* 21 */ DECLARE_EXPORT(sceCdCheckCmd)
/* 22 */ DECLARE_EXPORT(sceCdRI)

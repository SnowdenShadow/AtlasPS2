# The build runs inside a Linux container even when the checkout is on
# Windows. A Makefile or shell script checked out with CRLF breaks there,
# so line endings are LF in the repository regardless of platform.
* text=auto eol=lf

Makefile      text eol=lf
*.c           text eol=lf
*.h           text eol=lf
*.py          text eol=lf
*.sh          text eol=lf
*.md          text eol=lf
*.ini         text eol=lf
Dockerfile    text eol=lf

*.elf         binary
*.ELF         binary
*.irx         binary
*.png         binary
*.ttf         binary
*.zip         binary
